# Firebase Configuration
# Copy this to .env.local and fill in your real values
FIREBASE_API_KEY=YOUR_API_KEY_HERE
FIREBASE_AUTH_DOMAIN=shipyards-dev.firebaseapp.com
FIREBASE_PROJECT_ID=shipyards-dev
FIREBASE_STORAGE_BUCKET=shipyards-dev.appspot.com
FIREBASE_MESSAGING_SENDER_ID=YOUR_SENDER_ID_HERE
FIREBASE_APP_ID=YOUR_APP_ID_HERE
FIREBASE_MEASUREMENT_ID=YOUR_MEASUREMENT_ID_HERE

# Server Configuration
VITE_API_URL=https://api.shipyards.dev

# App Configuration
APP_ENV=development

# Feature Flags
ENABLE_GITHUB_AUTH=true
ENABLE_GOOGLE_AUTH=true
ENABLE_EMAIL_PASSWORD_AUTH=true

# Rate Limiting
RATE_LIMIT_REQUESTS_PER_MINUTE=100

# Security
SESSION_TIMEOUT_MINUTES=60
MAX_LOGIN_ATTEMPTS=5

